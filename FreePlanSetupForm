<!-- Form Script -->
<script>
  const bookingForm   = document.getElementById('booking-form');
  const submitBtn     = document.getElementById('submit-btn');
  const successMsg    = document.getElementById('success-message');

  // ── Helpers ────────────────────────────────────────────────────────
  function showError(id, msg) {
    const span = document.getElementById(id + '-error');
    const el   = document.getElementById(id);
    if (span) { span.textContent = msg; span.style.display = 'block'; }
    if (el)   { el.style.borderColor = '#ff4444'; }
  }
  function clearError(id) {
    const span = document.getElementById(id + '-error');
    const el   = document.getElementById(id);
    if (span) { span.textContent = ''; span.style.display = 'none'; }
    if (el)   { el.style.borderColor = 'rgba(59,130,246,0.3)'; }
  }

  // ── Blur validation on text fields ────────────────────────────────
  document.getElementById('instagram').addEventListener('blur', function () {
    if (!this.value.trim()) showError('instagram', 'Instagram username is required');
    else clearError('instagram');
  });
  document.getElementById('coaching-price').addEventListener('blur', function () {
    if (!this.value.trim()) showError('price', 'Coaching price is required');
    else clearError('price');
  });
  document.getElementById('first-message').addEventListener('blur', function () {
    if (!this.value.trim()) showError('message', 'Please enter the common first message');
    else clearError('message');
  });
  document.getElementById('trigger-keyword').addEventListener('blur', function () {
    if (!this.value.trim()) showError('keyword', 'Trigger keyword is required');
    else clearError('keyword');
  });

  // Clear on focus
  ['instagram','coaching-price','first-message','trigger-keyword'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('focus', function() {
      // map field id to error id
      var errId = id === 'coaching-price' ? 'price'
                : id === 'first-message'  ? 'message'
                : id === 'trigger-keyword'? 'keyword'
                : id;
      clearError(errId);
    });
  });

  // ── Submit ─────────────────────────────────────────────────────────
  bookingForm.addEventListener('submit', function (e) {
    e.preventDefault();

    // Clear all errors first
    ['instagram','goal','price','audience','message','keyword'].forEach(clearError);

    var hasError = false;

    // Instagram
    if (!document.getElementById('instagram').value.trim()) {
      showError('instagram', 'Instagram username is required'); hasError = true;
    }

    // Coaching Goal
    if (!document.querySelector('input[name="coaching_goal"]:checked')) {
      showError('goal', 'Please select a coaching goal'); hasError = true;
    }

    // Coaching Price
    if (!document.getElementById('coaching-price').value.trim()) {
      showError('price', 'Coaching price is required'); hasError = true;
    }

    // Target Audience
    if (!document.querySelector('input[name="target_audience"]:checked')) {
      showError('audience', 'Please select your target audience'); hasError = true;
    }

    // First Message
    if (!document.getElementById('first-message').value.trim()) {
      showError('message', 'Please enter the common first message'); hasError = true;
    }

    // Trigger Keyword
    if (!document.getElementById('trigger-keyword').value.trim()) {
      showError('keyword', 'Trigger keyword is required'); hasError = true;
    }

    // Scroll to first visible error
    if (hasError) {
      var firstErr = document.querySelector('.error-message[style*="block"]');
      if (firstErr) firstErr.parentElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    // ── All valid → loading state ──────────────────────────────────
    var btnText = submitBtn.querySelector('.btn-text');
    submitBtn.disabled = true;
    btnText.textContent = 'Submitting...';
    submitBtn.style.opacity = '0.7';

    // ── Build WhatsApp notification message ───────────────────────
    var instagram   = document.getElementById('instagram').value.trim().replace('@','');
    var goal        = document.querySelector('input[name="coaching_goal"]:checked').value;
    var price       = document.getElementById('coaching-price').value.trim();
    var audience    = document.querySelector('input[name="target_audience"]:checked').value;
    var firstMsg    = document.getElementById('first-message').value.trim();
    var keyword     = document.getElementById('trigger-keyword').value.trim();
    var bookingLink = document.getElementById('booking-link').value.trim();

    var waMessage =
'Hi! New Free Setup Request 🚀\n\n' +
'📱 Instagram: @' + instagram + '\n' +
'🎯 Coaching Goal: ' + goal + '\n' +
'💰 Coaching Price: ' + price + '\n' +
'👥 Target Audience: ' + audience + '\n' +
'💬 First Message Clients Send: ' + firstMsg + '\n' +
'🔑 Trigger Keyword: ' + keyword +
(bookingLink ? '\n🔗 Booking Link: ' + bookingLink : '');

    var encoded = encodeURIComponent(waMessage);

    // ── Send email via FormSubmit.co (fetch, no redirect) ─────────
    fetch('https://formsubmit.co/ajax/ayushtrades54@gmail.com', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        _subject:        'New DM Automation Setup Request 🚀',
        _template:       'box',
        _captcha:        'false',
        Instagram:       '@' + instagram,
        'Coaching Goal': goal,
        'Coaching Price': price,
        'Target Audience': audience,
        'First Message Clients Send': firstMsg,
        'Trigger Keyword': keyword,
        'Booking Link':  bookingLink || 'Not provided'
      })
    })
    .then(function() {
      // Email sent (or failed silently) — open WhatsApp either way
      window.open('https://wa.me/919477293867?text=' + encoded, '_blank');
      bookingForm.style.display = 'none';
      successMsg.style.display = 'block';
      successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
    })
    .catch(function() {
      // Even on network error, still notify via WhatsApp
      window.open('https://wa.me/919477293867?text=' + encoded, '_blank');
      bookingForm.style.display = 'none';
      successMsg.style.display = 'block';
      successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>

