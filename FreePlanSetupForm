        Your setup request has been received.<br>
        I'll now customise your DM replies and message you once it's ready.
      </p>
    </div>

    <!-- Setup Form -->
    <form id="booking-form" class="booking-form" action="https://formsubmit.co/ayushtrades54@gmail.com" method="POST">

      <!-- FormSubmit.co config -->
      <input type="hidden" name="_subject" value="New DM Automation Setup Request 🚀">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="box">
      <input type="text"   name="_honey" style="display:none">


      <!-- 1. Instagram Username -->
      <div class="form-group">
        <label for="instagram">Instagram Username *</label>
        <input type="text"
               id="instagram"
               name="instagram"
               placeholder="@yourusername or yourusername"
               required>
        <span class="error-message" id="instagram-error"></span>
      </div>

      <!-- 2. Coaching Goal -->
      <div class="form-group">
        <label>Coaching Goal *</label>
        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:8px;">
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="coaching_goal" value="Fat Loss" required> Fat Loss
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="coaching_goal" value="Muscle Gain"> Muscle Gain
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="coaching_goal" value="General Fitness"> General Fitness
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="coaching_goal" value="Weight Gain"> Weight Gain
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="coaching_goal" value="Mixed Coaching"> Mixed Coaching
          </label>
        </div>
        <span class="error-message" id="goal-error"></span>
      </div>

      <!-- 3. Average Coaching Price -->
      <div class="form-group">
        <label for="coaching-price">Average Coaching Price *</label>
        <input type="text"
               id="coaching-price"
               name="coaching_price"
               placeholder="e.g. ₹5,000/month or ₹15,000 for 3 months"
               required>
        <span class="error-message" id="price-error"></span>
      </div>

      <!-- 4. Target Audience -->
      <div class="form-group">
        <label>Target Audience *</label>
        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:8px;">
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="target_audience" value="Men" required> Men
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="target_audience" value="Women"> Women
          </label>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:400;">
            <input type="radio" name="target_audience" value="Both"> Both
          </label>
        </div>
        <span class="error-message" id="audience-error"></span>
      </div>

      <!-- 5. Common First Message -->
      <div class="form-group">
        <label for="first-message">Common First Message Clients Send *</label>
        <textarea id="first-message"
                  name="first_message"
                  rows="3"
                  placeholder="e.g. 'How much is your program?' or 'I want to lose weight, can you help?'"
                  required></textarea>
        <span class="error-message" id="message-error"></span>
      </div>

      <!-- 6. Trigger Keyword -->
      <div class="form-group">
        <label for="trigger-keyword">Trigger Keyword *</label>
        <input type="text"
               id="trigger-keyword"
               name="trigger_keyword"
               placeholder="e.g. INFO, DETAILS, JOIN, START"
               required>
        <span class="error-message" id="keyword-error"></span>
